{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "{index.html,favicon.svg,*.docx,*.pdf,*.jpg,src/**,data/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js?__pathname=/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index.js?__pathname=/$1"
    }
  ]
}
