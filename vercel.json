{
  "version": 2,
  "functions": {
    "api/**/*.js": {
      "includeFiles": "{index.html,favicon.svg,favicon.ico,favicon*.png,apple-touch-icon.png,*.docx,*.pdf,*.jpg,*.png,src/**,data/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/:slug*",
      "destination": "/api/[...slug]"
    }
  ]
}
